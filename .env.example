# RootzEngine Environment Configuration
# Copy this file to .env and fill in your values

# Environment
ROOTZENGINE_ENVIRONMENT=development
ROOTZENGINE_DEBUG=false

# Audio Processing
ROOTZENGINE_AUDIO__SAMPLE_RATE=44100
ROOTZENGINE_AUDIO__CHUNK_SIZE=1024
ROOTZENGINE_AUDIO__HOP_LENGTH=512
ROOTZENGINE_AUDIO__N_FFT=2048
ROOTZENGINE_AUDIO__N_MELS=128
ROOTZENGINE_AUDIO__N_MFCC=13

# API Settings
ROOTZENGINE_API__HOST=0.0.0.0
ROOTZENGINE_API__PORT=8000
ROOTZENGINE_API__DEBUG=false
ROOTZENGINE_API__RELOAD=true
ROOTZENGINE_API__WORKERS=1

# Storage
ROOTZENGINE_STORAGE__LOCAL_STORAGE_PATH=./data/storage
ROOTZENGINE_STORAGE__USE_AZURE=false

# Azure Storage (if enabled)
ROOTZENGINE_STORAGE__AZURE__CONNECTION_STRING=
ROOTZENGINE_STORAGE__AZURE__STORAGE_ACCOUNT=
ROOTZENGINE_STORAGE__AZURE__CONTAINER_NAME=rootzengine

# Machine Learning
ROOTZENGINE_ML__MODEL_PATH=
ROOTZENGINE_ML__TRAINING_DATA_PATH=./data/training
ROOTZENGINE_ML__CHECKPOINT_DIR=./data/checkpoints
ROOTZENGINE_ML__BATCH_SIZE=32
ROOTZENGINE_ML__LEARNING_RATE=0.001
ROOTZENGINE_ML__NUM_EPOCHS=100
ROOTZENGINE_ML__DEVICE=cpu

# MIDI Configuration
ROOTZENGINE_MIDI__TEMPO=120
ROOTZENGINE_MIDI__HUMANIZE_TIMING=true
ROOTZENGINE_MIDI__HUMANIZE_VELOCITY=true
ROOTZENGINE_MIDI__TIMING_VARIANCE=0.02
ROOTZENGINE_MIDI__VELOCITY_VARIANCE=0.15

# Demucs (Stem Separation)
ROOTZENGINE_DEMUCS__MODEL_NAME=htdemucs
ROOTZENGINE_DEMUCS__DEVICE=cpu
ROOTZENGINE_DEMUCS__SHIFTS=1

# Processing Pipeline
ROOTZENGINE_PROCESSING__ACCURACY_THRESHOLD=0.85
ROOTZENGINE_PROCESSING__MAX_EXTRACTION_MODE=true
ROOTZENGINE_PROCESSING__PRESERVE_INTERMEDIATES=false

# Logging
ROOTZENGINE_LOGGING__LEVEL=INFO
ROOTZENGINE_LOGGING__LOG_FILE=
ROOTZENGINE_LOGGING__LOG_TO_CONSOLE=true